<Window x:Class="TokenViewer.App.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TokenViewer.App.ViewModels"
        Title="TokenViewer"
        Width="360"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        BorderThickness="1"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">

    <Window.Resources>
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:ProviderCardViewModel}">
            <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- Header -->
                    <DockPanel LastChildFill="False">
                        <Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CompanyName}" Margin="4,0,0,0" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBlock Text="동기화 중..." Margin="8,0,0,0" Opacity="0.6" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding LoadingVisibility}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PlanName}" Opacity="0.7" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding PlanVisibility}" />
                    </DockPanel>
                    <TextBlock Text="{Binding StatusText}" Opacity="0.7" FontSize="11" Margin="18,2,0,6" TextTrimming="CharacterEllipsis" />

                    <!-- Quota windows -->
                    <ItemsControl ItemsSource="{Binding Windows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WindowRowViewModel}">
                                <StackPanel Margin="0,2,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Label}" FontSize="12" />
                                    </DockPanel>
                                    <ProgressBar Value="{Binding BarValue, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,2"
                                                 Foreground="{Binding BarBrush}" />
                                    <TextBlock Text="{Binding ResetText}" FontSize="10.5" Opacity="0.6" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="표시할 쿼터 윈도우가 없습니다." Opacity="0.6" FontSize="11" Visibility="{Binding NoWindowsVisibility}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#F59E0B" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"
                               Visibility="{Binding ErrorVisibility}" />

                    <!-- Actions -->
                    <DockPanel Margin="0,4,0,0" LastChildFill="False">
                        <TextBlock Text="{Binding LastUpdatedText}" FontSize="10.5" Opacity="0.5" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="로그인" Command="{Binding LoginCommand}" Padding="10,3"
                                Visibility="{Binding LoginVisibility}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding SignedInVisibility}">
                            <Button Content="새로고침" Command="{Binding RefreshCommand}" Padding="8,3" Margin="0,0,4,0" />
                            <Button Content="대시보드" Command="{Binding OpenDashboardCommand}" Padding="8,3" Margin="0,0,4,0" />
                            <Button Content="로그아웃" Command="{Binding SignOutCommand}" Padding="8,3" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock Text="TokenViewer" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border x:Name="DemoBadge" Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="#33F59E0B" VerticalAlignment="Center">
                <TextBlock Text="DEMO" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" />
            </Border>
            <Button DockPanel.Dock="Right" Content="설정" Click="OnSettingsClick" Padding="8,3" />
            <Button DockPanel.Dock="Right" x:Name="RefreshAllButton" Content="모두 새로고침" Click="OnRefreshAllClick" Padding="8,3" Margin="0,0,4,0" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" LastChildFill="False">
            <TextBlock Text="트레이 아이콘을 우클릭하면 메뉴가 열립니다" FontSize="10.5" Opacity="0.5" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="종료" Click="OnQuitClick" Padding="8,3" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CardsList" ItemTemplate="{StaticResource CardTemplate}" />
        </ScrollViewer>
    </DockPanel>
</Window>
