<Window x:Class="TokenViewer.App.Views.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TokenViewer.App.Views"
        Title="TokenViewer 위젯"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">
    <Border x:Name="Card"
            CornerRadius="10"
            Padding="10,7,10,7"
            Background="#1C1C1E"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Cursor="SizeAll"
            MouseLeftButtonDown="OnCardMouseLeftButtonDown">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="지금 새로고침" Click="OnRefreshClick" />
                <MenuItem Header="상세 보기" Click="OnOpenPopupClick" />
                <MenuItem Header="설정..." Click="OnSettingsClick" />
                <Separator />
                <MenuItem Header="투명도">
                    <MenuItem Header="100%" Tag="1.0" Click="OnOpacityClick" />
                    <MenuItem Header="90%" Tag="0.9" Click="OnOpacityClick" />
                    <MenuItem Header="75%" Tag="0.75" Click="OnOpacityClick" />
                    <MenuItem Header="60%" Tag="0.6" Click="OnOpacityClick" />
                </MenuItem>
                <MenuItem Header="위치 초기화" Click="OnResetPositionClick" />
                <MenuItem Header="위젯 숨기기" Click="OnHideClick" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:WidgetRow}">
                        <Grid Margin="0,2" ToolTip="{Binding Tooltip}" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E6FFFFFF" FontSize="12"
                                       Margin="6,0,8,0" MinWidth="44" VerticalAlignment="Center" />
                            <Grid Grid.Column="2" Height="4" VerticalAlignment="Center">
                                <Border CornerRadius="2" Background="#26FFFFFF" />
                                <Border CornerRadius="2" Background="{Binding BarBrush}" HorizontalAlignment="Left"
                                        Width="{Binding BarWidth}" />
                            </Grid>
                            <TextBlock Grid.Column="3" Text="{Binding Value}" Foreground="White" FontSize="13"
                                       FontWeight="SemiBold" Margin="8,0,0,0" MinWidth="34" TextAlignment="Right"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding Reset}" Foreground="#99FFFFFF" FontSize="11"
                                       Margin="6,0,0,0" MinWidth="24" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyText" Text="표시할 AI가 없습니다" Foreground="#99FFFFFF" FontSize="11"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
