<Window x:Class="TokenViewer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TokenViewer.App.ViewModels"
        Title="TokenViewer 설정"
        Width="620" Height="640"
        WindowStartupLocation="CenterScreen">

    <TabControl Margin="12">
        <!-- AI 계정 · 순서 -->
        <TabItem Header="AI 계정 · 순서">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="AI 구독 계정 및 트레이 표시 순서" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,12" Opacity="0.7" TextWrapping="Wrap"
                               Text="각 AI 서비스에 앱 내에서 독립적으로 로그인하고, 트레이 아이콘 표시 여부와 순서를 조정할 수 있습니다. 순서는 아이콘을 만드는 순서이며, 실제 위치는 Windows가 정합니다(아이콘을 끌어서 옮길 수 있습니다)." />

                    <ItemsControl ItemsSource="{Binding ProviderRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProviderSettingsRow}">
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CompanyName}" Opacity="0.6" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <CheckBox Content="트레이 표시" IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Content="▲" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" Padding="8,2" Margin="0,0,2,0" ToolTip="위로" />
                                                <Button Content="▼" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" Padding="8,2" ToolTip="아래로" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,0" LastChildFill="False">
                                            <TextBlock Text="{Binding StatusText}" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="{Binding LoginButtonText}" Command="{Binding LoginCommand}" Padding="10,3" Margin="0,0,4,0" />
                                                <Button Content="로그아웃" Command="{Binding SignOutCommand}" IsEnabled="{Binding IsAuthenticated}" Padding="10,3" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Expander Header="고급: 수동 토큰/세션 쿠키 입력" Margin="0,8,0,0" Visibility="{Binding ManualTokenVisibility}">
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Text="{Binding ManualTokenLabel}" Opacity="0.7" Margin="0,0,0,2" />
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="저장" Margin="6,0,0,0" Padding="10,3"
                                                            Command="{Binding SaveManualTokenCommand}"
                                                            CommandParameter="{Binding ElementName=TokenBox}" />
                                                    <PasswordBox x:Name="TokenBox" />
                                                </DockPanel>
                                                <TextBlock Text="비워 두고 저장하면 저장된 값을 삭제합니다." Opacity="0.5" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 표시 모양 -->
        <TabItem Header="트레이 모양">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="트레이 실시간 미리보기" FontSize="15" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                        <StackPanel Margin="0,0,16,0">
                            <Border Background="#202020" CornerRadius="6" Padding="10,6">
                                <ItemsControl ItemsSource="{Binding PreviewDark}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding}" Width="32" Height="32" Margin="4,0" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="다크 작업 표시줄" Opacity="0.6" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <Border Background="#F3F3F3" CornerRadius="6" Padding="10,6">
                                <ItemsControl ItemsSource="{Binding PreviewLight}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding}" Width="32" Height="32" Margin="4,0" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Text="라이트 작업 표시줄" Opacity="0.6" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="표시 모양" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding DisplayStyles}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.DisplayStyle}" />
                    <TextBlock Text="{Binding DisplayStyleDescription}" Opacity="0.6" FontSize="11" Margin="0,2,0,12" TextWrapping="Wrap" />

                    <TextBlock Text="표시 수치" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding MetricModes}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.MetricMode}" Margin="0,0,0,12" />

                    <TextBlock Text="여러 쿼터 윈도우 중 아이콘에 표시할 기준" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding WindowStrategies}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.WindowStrategy}" Margin="0,0,0,12" />

                    <TextBlock Text="색상 테마" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ColorModes}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.ColorMode}" Margin="0,0,0,12" />

                    <CheckBox Content="원형 게이지 안에 퍼센트 수치 표시 (끄면 AI 약자 표시)" IsChecked="{Binding Settings.ShowPercentInIcon}" />

                    <TextBlock Text="플로팅 위젯" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8" />
                    <CheckBox Content="항상 위에 떠 있는 미니 위젯 표시" IsChecked="{Binding Settings.WidgetEnabled}" />
                    <TextBlock Opacity="0.6" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"
                               Text="끌어서 이동, 더블클릭하면 상세 팝업, 우클릭하면 투명도·숨기기 메뉴가 열립니다." />
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding WidgetOpacityText}" FontWeight="SemiBold" />
                        <TextBlock Text="위젯 불투명도" />
                    </DockPanel>
                    <Slider Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.WidgetOpacity}" />
                    <Button Content="위젯 위치 초기화" Command="{Binding ResetWidgetPositionCommand}" Padding="10,3"
                            HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 알림 · 일반 -->
        <TabItem Header="알림 · 일반">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="잔여량 부족 알림" FontSize="15" FontWeight="SemiBold" />
                    <CheckBox Content="임계치 도달 시 Windows 알림 받기" IsChecked="{Binding Settings.NotificationsEnabled}" Margin="0,8,0,8" />
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ThresholdText}" FontWeight="SemiBold" />
                        <TextBlock Text="경고 임계치 (잔여량 기준)" />
                    </DockPanel>
                    <Slider Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding Settings.WarningThresholdPercent}" />

                    <TextBlock Text="알림 대상 AI" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding ProviderRows}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProviderSettingsRow}">
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsNotified}" Margin="0,0,16,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="테스트 알림 보내기" Command="{Binding SendTestNotificationCommand}" Padding="10,3" Margin="0,0,6,0" />
                        <Button Content="알림 중복 기록 초기화" Command="{Binding ResetAlertHistoryCommand}" Padding="10,3" />
                    </StackPanel>

                    <TextBlock Text="동기화" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8" />
                    <TextBlock Text="자동 갱신 주기" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding RefreshIntervals}" DisplayMemberPath="Title" SelectedValuePath="Value"
                              SelectedValue="{Binding Settings.RefreshIntervalSeconds}" />

                    <TextBlock Text="시스템" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8" />
                    <CheckBox Content="Windows 로그인 시 자동 실행" IsChecked="{Binding Settings.LaunchAtLogin}" />

                    <TextBlock Text="개발 / 미리보기" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8" />
                    <CheckBox Content="데모 데이터 모드 (로그인 없이 UI/알림 테스트)" IsChecked="{Binding Settings.DemoModeEnabled}" />

                    <TextBlock Text="정보" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,4" />
                    <TextBlock Text="{Binding VersionText}" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                               Text="Codex, Claude, Gemini 구독 잔여량을 Windows 작업 표시줄 트레이에서 독립적으로 모니터링합니다." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
