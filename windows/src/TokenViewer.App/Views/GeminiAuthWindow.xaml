<Window x:Class="TokenViewer.App.Views.GeminiAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini (Google) 인증 — TokenViewer"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Gemini (Google) 연동 설정" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,14" Opacity="0.7" TextWrapping="Wrap"
                   Text="개인 Google AI 구독은 'Antigravity 자동 연동'으로 별도 인증·과금 없이 실시간 잔여량을 조회할 수 있습니다." />

        <TabControl x:Name="Tabs">
            <TabItem Header="Antigravity 자동 연동 (권장)">
                <StackPanel Margin="12">
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Antigravity IDE가 실행 중이면 로컬 language_server에서 Gemini 잔여량을 자동으로 가져옵니다. IDE를 닫으면 마지막으로 받은 값을 표시합니다." />
                    <TextBlock x:Name="AntigravityStatus" Margin="0,10,0,0" FontWeight="SemiBold" Text="실행 상태 확인 중..." />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ConnectAntigravityButton" Content="Antigravity 연결" Click="OnConnectAntigravity" Padding="12,4" />
                        <Button Content="실행 상태 다시 확인" Click="OnRecheckAntigravity" Padding="12,4" Margin="6,0,0,0" />
                        <Button Content="Antigravity 다운로드" Click="OnDownloadAntigravity" Padding="12,4" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="OAuth 2.0 (기업용)">
                <StackPanel Margin="12">
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="Google Cloud Console에서 '데스크톱 앱' 유형의 OAuth 클라이언트를 만든 뒤 입력하세요. 브라우저에서 로그인하면 127.0.0.1 로컬 콜백으로 토큰을 받습니다." />
                    <TextBlock Text="OAuth Client ID (필수)" Margin="0,10,0,2" />
                    <TextBox x:Name="ClientIdBox" />
                    <TextBlock Text="OAuth Client Secret" Margin="0,8,0,2" />
                    <PasswordBox x:Name="ClientSecretBox" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="GoogleSignInButton" Content="Google로 로그인" Click="OnGoogleSignIn" Padding="12,4" />
                        <Button Content="① OAuth 동의 화면" Click="OnOpenConsentScreen" Padding="10,4" Margin="6,0,0,0" />
                        <Button Content="② 사용자 인증 정보" Click="OnOpenCredentials" Padding="10,4" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Access Token 입력">
                <StackPanel Margin="12">
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="이미 발급받은 OAuth Access Token을 직접 입력합니다. 토큰이 만료되면 다시 입력해야 합니다." />
                    <TextBlock Text="OAuth Access Token (필수)" Margin="0,10,0,2" />
                    <PasswordBox x:Name="AccessTokenBox" />
                    <TextBlock Text="계정 이메일 (카드 표시용, 선택)" Margin="0,8,0,2" />
                    <TextBox x:Name="EmailBox" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="토큰 저장" Click="OnSaveToken" Padding="12,4" />
                        <Button Content="Google OAuth Playground 열기" Click="OnOpenPlayground" Padding="10,4" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ResultText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#F59E0B" Visibility="Collapsed" />

        <Button Content="닫기" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="14,4" Click="OnCloseClick" />
    </StackPanel>
</Window>
