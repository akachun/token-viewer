<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TokenViewer</AssemblyName>
    <RootNamespace>TokenViewer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Allows `dotnet build` (compile check only) from macOS/Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF0001: Application.ThemeMode (Fluent theme) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF implicit usings omit System.IO and System.Net.Http. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TokenViewer.Core\TokenViewer.Core.csproj" />
  </ItemGroup>

</Project>
